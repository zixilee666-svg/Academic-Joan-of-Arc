# ═══════════════════════════════════════════════════════════
# AI-Scientist Hub 环境配置模板
# 复制为 .env 后修改：cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── 数据库 ───
DATABASE_URL=sqlite:///data/ai_scientist.db

# ─── 推理引擎提供方 ───
# ollama  = 本地 Ollama 离线推理（默认）
# bailian = 阿里云百炼平台(千问) —— 比赛硬性要求"通过百炼平台调用模型API"
LLM_PROVIDER=ollama

# ─── Ollama 本地模型服务（LLM_PROVIDER=ollama 时使用）───
OLLAMA_HOST=http://localhost:11434

# ─── 阿里云百炼(DashScope) 配置（LLM_PROVIDER=bailian 时使用）───
# 获取地址：https://bailian.console.aliyun.com/ （百炼平台 → API-KEY）
# 注意：提交作品时必须提供此调用凭证的截图！
DASHSCOPE_API_KEY=
BAILIAN_API_KEY=
# 千问模型映射（可覆盖）
BAILIAN_MODEL_REASONING=qwen-max
BAILIAN_MODEL_GENERAL=qwen-plus
BAILIAN_MODEL_CODING=qwen-plus
BAILIAN_MODEL_MULTIMODAL=qwen-vl-max

# ─── 模型映射（根据内存选择7B或14B）───
# 8GB内存：全部用7B
# 16GB+内存：推理用14B，通用用7B
MODEL_REASONING=qwen2.5:14b
MODEL_GENERAL=qwen2.5:7b
MODEL_CODING=qwen2.5-coder:7b

# ─── 运行模式 ───
# offline = 完全离线（默认）
# online = 允许在线更新文献
RUN_MODE=offline

# ─── 日志 ───
LOG_LEVEL=INFO

# ─── 认证 ───
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRE_HOURS=24

# ─── 前端 ───
API_BASE_URL=http://localhost:8000
